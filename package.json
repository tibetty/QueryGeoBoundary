{
  "name": "query-geo-boundary",
  "version": "0.3.6",
  "description": "Query the boundary of an administrative area from OpenStreetMap Nominatim or Overpass as GeoJSON",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rolldown -c && node scripts/copy-dts.mjs",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --noEmit",
    "coverage": "npm run build && vitest run --coverage",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "prepublishOnly": "npm run typecheck && npm run coverage && npm run check:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tibetty/QueryGeoBoundary.git"
  },
  "bugs": {
    "url": "https://github.com/tibetty/QueryGeoBoundary/issues"
  },
  "homepage": "https://github.com/tibetty/QueryGeoBoundary#readme",
  "keywords": [
    "map",
    "geo",
    "boundary",
    "polygon",
    "geojson",
    "osm",
    "nominatim",
    "overpass",
    "typescript"
  ],
  "author": "tibetty",
  "license": "MIT",
  "dependencies": {
    "osm2geojson-lite": "^3.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "publint": "^0.3.25",
    "rolldown": "^1.3.3",
    "rolldown-plugin-dts": "^0.30.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
